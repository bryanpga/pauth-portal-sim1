<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' - ' : '' %><%= portalName %> Provider Portal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="brandbar">
  <div class="brand"><span class="logo"></span><%= portalName %> <small>Provider Portal &middot; Utilization Management</small></div>
  <div class="userbox">Signed in as <strong><%= user.displayName %></strong> (<%= user.org %>) <a href="/logout">Sign Out</a></div>
</div>
<nav class="mainnav">
  <a href="/requests" class="<%= active === 'requests' ? 'active' : '' %>">
    <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg></span>
    My Organization's Requests
  </a>
  <a href="/create" class="<%= active === 'create' ? 'active' : '' %>">
    <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></span>
    Create New Request
  </a>
  <a href="/search" class="<%= active === 'search' ? 'active' : '' %>">
    <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg></span>
    Search Submitted Requests
  </a>
  <a href="/case-status" class="<%= active === 'status' ? 'active' : '' %>">
    <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg></span>
    Check Case Status
  </a>
</nav>
<div class="page">
